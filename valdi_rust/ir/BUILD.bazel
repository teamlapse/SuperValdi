load(
    "//bzl/valdi:valdi_rust.bzl",
    "valdi_rust_framework_crate",
    "valdi_rust_schema_test",
)

valdi_rust_framework_crate(
    name = "ir",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "valdi_rust_ir",
    visibility = ["//visibility:public"],
)

valdi_rust_schema_test(
    name = "schema_coverage_test",
    srcs = ["tests/schema_coverage_test.rs"],
    deps = [":ir"],
)

valdi_rust_schema_test(
    name = "typed_extensions_test",
    srcs = ["tests/typed_extensions_test.rs"],
    deps = [":ir"],
)

valdi_rust_schema_test(
    name = "public_examples_test",
    srcs = ["tests/public_examples_test.rs"],
    deps = [":ir"],
)

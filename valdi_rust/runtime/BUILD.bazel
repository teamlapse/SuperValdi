load(
    "//bzl/valdi:valdi_rust.bzl",
    "valdi_rust_framework_crate",
    "valdi_rust_runtime_test",
)

valdi_rust_framework_crate(
    name = "runtime",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "valdi_rust_runtime",
    deps = [
        "//valdi_rust/backend",
        "//valdi_rust/ir",
    ],
    visibility = ["//visibility:public"],
)

COMMON_TEST_DEPS = [
    ":runtime",
    "//valdi_rust/backend",
    "//valdi_rust/ir",
]

filegroup(
    name = "static_fixture_backend_ops_snapshot",
    srcs = ["snapshots/static_fixture_backend_ops.snap"],
)

filegroup(
    name = "state_binding_action_trace_snapshot",
    srcs = ["snapshots/state_binding_action_trace.snap"],
)

valdi_rust_runtime_test(
    name = "document_loader_test",
    srcs = ["tests/document_loader_test.rs"],
    deps = COMMON_TEST_DEPS,
)

valdi_rust_runtime_test(
    name = "tree_diff_test",
    srcs = ["tests/tree_diff_test.rs"],
    deps = COMMON_TEST_DEPS,
)

valdi_rust_runtime_test(
    name = "identity_patch_test",
    srcs = ["tests/identity_patch_test.rs"],
    deps = COMMON_TEST_DEPS,
)

valdi_rust_runtime_test(
    name = "rebuild_diagnostic_test",
    srcs = ["tests/rebuild_diagnostic_test.rs"],
    deps = COMMON_TEST_DEPS,
)

valdi_rust_runtime_test(
    name = "static_fixture_backend_ops_snapshot_test",
    srcs = ["tests/static_fixture_backend_ops_snapshot_test.rs"],
    compile_data = [":static_fixture_backend_ops_snapshot"],
    deps = COMMON_TEST_DEPS,
)

valdi_rust_runtime_test(
    name = "state_store_test",
    srcs = ["tests/state_store_test.rs"],
    deps = COMMON_TEST_DEPS,
)

valdi_rust_runtime_test(
    name = "binding_evaluator_test",
    srcs = ["tests/binding_evaluator_test.rs"],
    deps = COMMON_TEST_DEPS,
)

valdi_rust_runtime_test(
    name = "action_scheduler_test",
    srcs = ["tests/action_scheduler_test.rs"],
    deps = COMMON_TEST_DEPS,
)

valdi_rust_runtime_test(
    name = "event_action_binding_test",
    srcs = ["tests/event_action_binding_test.rs"],
    deps = COMMON_TEST_DEPS,
)

valdi_rust_runtime_test(
    name = "state_patch_compatibility_test",
    srcs = ["tests/state_patch_compatibility_test.rs"],
    deps = COMMON_TEST_DEPS,
)

valdi_rust_runtime_test(
    name = "state_binding_action_snapshot_test",
    srcs = ["tests/state_binding_action_snapshot_test.rs"],
    compile_data = [":state_binding_action_trace_snapshot"],
    deps = COMMON_TEST_DEPS,
)

test_suite(
    name = "runtime_tree_diff_tests",
    tests = [
        ":document_loader_test",
        ":identity_patch_test",
        ":rebuild_diagnostic_test",
        ":static_fixture_backend_ops_snapshot_test",
        ":tree_diff_test",
    ],
)

test_suite(
    name = "state_bindings_actions_tests",
    tests = [
        ":action_scheduler_test",
        ":binding_evaluator_test",
        ":event_action_binding_test",
        ":state_binding_action_snapshot_test",
        ":state_patch_compatibility_test",
        ":state_store_test",
    ],
)
